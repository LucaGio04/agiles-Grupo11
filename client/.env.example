# URL base del backend, sin barra final y sin /api.
# Las llamadas ya incluyen el path (/api/health, /api/items, ...).
# En Vercel se carga en el panel: Vite la embebe en el build, así que
# cambiarla exige un redeploy del frontend.

# Desarrollo
VITE_API_URL=http://localhost:3001

# Producción (valor ficticio; no descomentar en el .env local)
# VITE_API_URL=https://truequeutn-api.onrender.com
