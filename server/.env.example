# Puerto del servidor Express
PORT=3001

# URL del frontend (usada por CORS). Usá localhost (no 127.0.0.1) en el navegador.
CLIENT_URL=http://localhost:5173

# Conexión a PostgreSQL. Coincide con docker-compose.yml de la raíz.
DATABASE_URL="postgresql://trueque:trueque@localhost:5432/truequeutn?schema=public"

# Secreto para firmar los JWT de sesión. Usá un valor largo y aleatorio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Dominio institucional permitido para el registro de usuarios (HU-01)
ALLOWED_EMAIL_DOMAIN=utn.edu.ar
