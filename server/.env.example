# Desarrollo local. En producción estas variables se cargan en el panel de Render,
# nunca en un .env del repo. Los valores comentados de abajo son ficticios.

# development en local, production en Render.
NODE_ENV=development

# Puerto del servidor Express. Render inyecta PORT: no lo cargues en el panel.
PORT=3001

# Un solo origen del frontend, sin barra final. Tiene que coincidir exactamente
# con la URL del navegador (CORS). En producción, la URL https de Vercel.
CLIENT_URL=http://localhost:5173

# Conexión a PostgreSQL. El valor de abajo coincide con docker-compose.yml.
# En Render, si usás la External Database URL, agregá sslmode=require.
# La Internal Database URL (mismo servicio, red interna) no lo necesita.
DATABASE_URL="postgresql://trueque:trueque@localhost:5432/truequeutn?schema=public"

# Secreto para firmar los JWT de sesión. En producción, un valor largo y aleatorio, por ejemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Dominio institucional permitido para el registro de usuarios (HU-01).
ALLOWED_EMAIL_DOMAIN=utn.edu.ar

# Fotos de los ítems (HU-13). Ambas son opcionales.
# Carpeta donde se guardan (por defecto server/uploads). En el plan gratuito de Render
# ese disco se borra al reiniciar o redeployar.
# UPLOADS_DIR=./uploads
# URL pública https del backend, sin barra final, para armar el link de cada foto.
# Hay que fijarla en producción: si no, el link puede salir en http y el navegador
# bloquea la imagen (contenido mixto).
# API_PUBLIC_URL=http://localhost:3001

# --- Producción (referencia; no descomentar en el .env local) ---
# NODE_ENV=production
# CLIENT_URL=https://truequeutn.vercel.app
# DATABASE_URL="postgresql://trueque:clave-ficticia@dpg-ejemplo.oregon-postgres.render.com:5432/truequeutn?sslmode=require"
# JWT_SECRET=ejemplo-a1b2c3d4e5f6-secreto-largo-generado-en-el-panel
# ALLOWED_EMAIL_DOMAIN=utn.edu.ar
# API_PUBLIC_URL=https://truequeutn-api.onrender.com
